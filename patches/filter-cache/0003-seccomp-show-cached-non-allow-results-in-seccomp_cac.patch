From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Minchan Kwon <tronve@naver.com>
Date: Thu, 26 Nov 2026 07:53:39 +0000
Subject: [PATCH] seccomp: show cached non-allow results in seccomp_cache

With CONFIG_SECCOMP_CACHE_DEBUG, print syscalls that have a cached
constant non-allow result as "DENY <result>" in
/proc/<pid>/seccomp_cache, followed by "LOG" when the filter that
produced the result was installed with SECCOMP_FILTER_FLAG_LOG.

This makes it possible to check the deny cache before it is used.
---
 kernel/seccomp.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/kernel/seccomp.c b/kernel/seccomp.c
index 1ff7b8b5c..cb9754376 100644
--- a/kernel/seccomp.c
+++ b/kernel/seccomp.c
@@ -2647,15 +2647,20 @@ device_initcall(seccomp_sysctl_init)
 #ifdef CONFIG_SECCOMP_CACHE_DEBUG
 /* Currently CONFIG_SECCOMP_CACHE_DEBUG implies SECCOMP_ARCH_NATIVE */
 static void proc_pid_seccomp_cache_arch(struct seq_file *m, const char *name,
-					const void *bitmap, size_t bitmap_size)
+					const void *bitmap,
+					const struct seccomp_cache_entry *deny,
+					size_t bitmap_size)
 {
 	int nr;
 
 	for (nr = 0; nr < bitmap_size; nr++) {
-		bool cached = test_bit(nr, bitmap);
-		char *status = cached ? "ALLOW" : "FILTER";
-
-		seq_printf(m, "%s %d %s\n", name, nr, status);
+		if (test_bit(nr, bitmap))
+			seq_printf(m, "%s %d ALLOW\n", name, nr);
+		else if (deny[nr].valid)
+			seq_printf(m, "%s %d DENY %#010x%s\n", name, nr, deny[nr].ret,
+				   deny[nr].log ? " LOG" : "");
+		else
+			seq_printf(m, "%s %d FILTER\n", name, nr);
 	}
 }
 
@@ -2687,11 +2692,13 @@ int proc_pid_seccomp_cache(struct seq_file *m, struct pid_namespace *ns,
 
 	proc_pid_seccomp_cache_arch(m, SECCOMP_ARCH_NATIVE_NAME,
 				    f->cache.allow_native,
+				    f->cache.deny_native,
 				    SECCOMP_ARCH_NATIVE_NR);
 
 #ifdef SECCOMP_ARCH_COMPAT
 	proc_pid_seccomp_cache_arch(m, SECCOMP_ARCH_COMPAT_NAME,
 				    f->cache.allow_compat,
+				    f->cache.deny_compat,
 				    SECCOMP_ARCH_COMPAT_NR);
 #endif /* SECCOMP_ARCH_COMPAT */
 
